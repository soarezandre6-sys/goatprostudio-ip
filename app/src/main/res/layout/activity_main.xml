<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:background="@drawable/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_logo_badge"
                android:clipToOutline="true"
                android:elevation="9dp"
                android:outlineProvider="background"
                android:padding="7dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Logo GOAT PRO IP"
                    android:scaleType="fitCenter"
                    android:src="@drawable/goat_pro_ip_mark" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.02"
                    android:text="GOAT PRO IP"
                    android:textColor="@color/gold"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Câmera IP profissional para o GOAT PRO Studio"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="BUILD 11 • ANDROID 16 • MULTI-LENTE"
                    android:textColor="@color/gold_soft"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_preview_frame"
            android:clipToOutline="true"
            android:elevation="10dp"
            android:outlineProvider="background"
            android:padding="2dp">

            <androidx.camera.view.PreviewView
                android:id="@+id/previewView"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:background="#000000"
                app:implementationMode="performance"
                app:scaleType="fitCenter" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_status"
            android:elevation="7dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:text="CONEXÃO COM O STUDIO"
                android:textColor="@color/gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="PRONTO PARA TRANSMITIR"
                android:textColor="@color/green"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/connectionStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="SEM CONEXÃO ATIVA"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/autoDiscoverySwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:checked="true"
                android:text="Conexão automática com o GOAT PRO Studio: LIGADA"
                android:textColor="@color/text"
                android:textSize="13sp"
                app:thumbTint="@color/gold"
                app:trackTint="@color/line" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Desligada: o stream continua pelo IP, mas este celular deixa de se anunciar automaticamente."
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/addressText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_address"
                android:fontFamily="monospace"
                android:text="http://0.0.0.0:8080/video"
                android:textColor="@color/text"
                android:textIsSelectable="true"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/streamInfoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="1080p • alvo 30 FPS • MJPEG / Wi-Fi local"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/performanceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Desempenho: aguardando transmissão…"
                android:textColor="@color/green"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/copyAddressButton"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_round"
                android:backgroundTint="@color/panel_3"
                android:elevation="4dp"
                android:minHeight="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Copiar endereços"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_raised"
            android:elevation="7dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:text="CÂMERA E TRANSMISSÃO"
                android:textColor="@color/gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Câmera / lente"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/cameraLensSpinner"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input"
                android:popupBackground="@color/panel_2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Resolução"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/resolutionSpinner"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input"
                android:popupBackground="@color/panel_2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Qualidade / largura de banda"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/qualitySpinner"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input"
                android:popupBackground="@color/panel_2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Rotação da imagem transmitida"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/rotationSpinner"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_input"
                android:popupBackground="@color/panel_2" />

            <Button
                android:id="@+id/switchCameraButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_round"
                android:backgroundTint="@color/panel_3"
                android:elevation="4dp"
                android:text="Próxima câmera / lente"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textStyle="bold" />

            <Button
                android:id="@+id/torchButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_button_round"
                android:backgroundTint="@color/panel_3"
                android:elevation="4dp"
                android:text="Lanterna: desligada"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_raised"
            android:elevation="7dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                android:text="ÁUDIO"
                android:textColor="@color/gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="O microfone é opcional. Com o áudio desligado, a transmissão continua somente em vídeo."
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/audioButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_button_round"
                android:backgroundTint="@color/panel_3"
                android:elevation="4dp"
                android:text="Áudio: desligado"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/streamButton"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_primary"
            android:elevation="10dp"
            android:text="Iniciar transmissão"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_status"
            android:elevation="5dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Conheça o ecossistema completo"
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <Button
                android:id="@+id/websiteButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_button_round"
                android:backgroundTint="@color/panel_3"
                android:elevation="3dp"
                android:text="Conheça o GOAT PRO Studio  ↗"
                android:textAllCaps="false"
                android:textColor="@color/gold_soft"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="goatprostudio.com.br"
                android:textColor="@color/muted"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:gravity="center"
            android:text="GOAT PRO IP • Build 11 experimental • Android 16"
            android:textColor="@color/muted"
            android:textSize="10sp" />

    </LinearLayout>
</ScrollView>
